# =========================================================
# Personal OS (chemicvll) Environment Variables
# =========================================================

# Supabase Cloud Project Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Master PIN Protection (Option 2: Personal OS Lock Screen)
NEXT_PUBLIC_APP_PIN=2026

# Local Runner Daemon Secret (for desktop server control)
LOCAL_DAEMON_SECRET=change-this-to-a-secure-random-token

# Server-only Supabase Service Role Key (for Telegram webhook & Vercel Cron)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Telegram Bot Integration (Hybrid Mobile Capture & Daily Digest)
TELEGRAM_BOT_TOKEN=123456789:your-botfather-token
TELEGRAM_ALLOWED_CHAT_ID=your-numeric-telegram-chat-id
TELEGRAM_WEBHOOK_SECRET=change-this-to-a-random-webhook-secret

# Groq Whisper API (for voice note audio transcription via Telegram)
# Get free API key at https://console.groq.com
GROQ_API_KEY=gsk_your-groq-api-key-here

# Vercel Cron Secret & Public App URL (for deep-link buttons in Telegram)
CRON_SECRET=change-this-to-a-random-cron-secret
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
